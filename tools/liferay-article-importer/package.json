{
  "name": "@nexcent/liferay-flat-structured-content-importer",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "cli": "node cli/index.js",
    "dev": "concurrently -k -n api,ui -c auto \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "node --watch server/index.js",
    "dev:ui": "vite --host 127.0.0.1 --force",
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run typecheck && npm run build && node scripts/check.mjs && node cli/index.js help"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "lucide-react": "1.26.0",
    "multer": "2.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.4",
    "sass": "^1.89.0",
    "typescript": "^5.9.2",
    "vite": "^8.1.5"
  }
}
